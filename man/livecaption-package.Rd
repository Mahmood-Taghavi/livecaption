\name{livecaption-package}
\alias{livecaption}
\alias{livecaption-package}
\title{Extract Windows Live Captions Text into R}
\description{
Extract text produced by Windows 11 Live Captions and bring it into ordinary R
objects for further processing, analysis, transformation, and export.
}
\details{
Version 0.1.8 provides application controls, in-memory caption bookmarks,
overlap-aware text extraction between bookmarks, immediate capture relative to
a stored baseline, and clipboard export. The resulting character strings and
data frames can be used with normal R tools or saved for other applications.
Continuous recording, subtitle generation, and Shiny functionality are outside
the scope of this release.
}
\docType{package}
\keyword{package}
